# 複製成 .env 後填入。Docker 與本機開發共用同一份(.env 已被 gitignore)。

# API 監聽埠
PORT=8787
# SQLite 資料目錄。Docker 用 /data(volume);
# 本機(非 Docker)開發請刪掉這行或改成 ./data — server 預設就是 ./data
DATA_DIR=/data
# CORS 允許的前端來源(逗號分隔)
# 樹莓派部署時加上 http://<Pi IP>:8080,例:http://localhost:3000,http://localhost:8080,http://192.168.8.192:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# 時區
TZ=Asia/Taipei
# 外部 API 金鑰(可留空)
GEMINI_API_KEY=
USDA_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# AI 復盤(Anthropic Claude)。金鑰只放 .env,不要進 git;留空 = AI 復盤回 503
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# AI 復盤每日 / 每月花費上限(USD,日界 / 月界以台北時間計),用完回 429
AI_DAILY_USD=1
AI_MONTHLY_USD=10
# 前端(Vite)build 時使用;空白 = 同源 /api
VITE_API_URL=
