{
  "name": "furlogic",
  "version": "1.0.1",
  "description": "智能寵物營養管理系統",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server --if-present\"",
    "build": "npm run build -w client",
    "lint": "eslint client/src server/src shared/src --ext .js,.jsx --no-error-on-unmatched-pattern",
    "format": "prettier --write \"{client,shared,server}/src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"{client,shared,server}/src/**/*.{js,jsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.3.3",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "pet",
    "nutrition",
    "dog",
    "health",
    "food",
    "calculator"
  ],
  "author": "yuzenchen",
  "license": "MIT"
}
