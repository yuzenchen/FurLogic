# syntax=docker/dockerfile:1
# FurLogic API (Fastify + better-sqlite3)。可在 amd64 / arm64 (Raspberry Pi) build。

# ---- deps: 只安裝 server 的 production 依賴 ----
FROM node:22-slim AS deps
WORKDIR /app
# better-sqlite3 若無對應平台 prebuild 會退回 node-gyp 編譯,需要 python3/make/g++
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
# 所有 workspace 的 package.json 都要在,npm ci 才會接受 lockfile
COPY package.json package-lock.json ./
COPY client/package.json client/package.json
COPY server/package.json server/package.json
COPY shared/package.json shared/package.json
RUN npm ci -w server --omit=dev --no-audit --no-fund \
 && npm cache clean --force

# ---- runtime ----
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8787 \
    DATA_DIR=/data \
    HOST=0.0.0.0
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY server/package.json server/package.json
COPY shared/ shared/
COPY server/ server/
RUN mkdir -p /data && chown node:node /data
USER node
EXPOSE 8787
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/src/index.js"]
